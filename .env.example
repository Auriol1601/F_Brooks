# Copier ce fichier en .env et indiquer le dossier d'architecture du projet en cours.
# Utilisé par docker compose (dossier affiché par Structurizr)
# et par l'extension pi save-dsl (dossier où le DSL est enregistré).
# Sans valeur : structurizr/ de ce dépôt.
FBROOKS_PROJECT_DIR=D:/mon_projet/architecture
